---
# NGC API Key Secret (for Helm chart authentication)
# IMPORTANT: This file is a TEMPLATE - update NGC_API_KEY before applying
apiVersion: v1
kind: Secret
metadata:
  name: runai-ngc-secret
  namespace: fleet-default
type: Opaque
stringData:
  ngc-api-key: "YOUR_NGC_API_KEY_HERE"
---
# IMPORTANT INSTRUCTIONS:
# 1. Get your NGC API key from: https://org.ngc.nvidia.com/setup/api-key
# 2. Replace YOUR_NGC_API_KEY_HERE with your actual key
# 3. Rename to run-ai-secrets.yaml (remove .template)
# 4. Apply with: kubectl apply -f fleet/run-ai-secrets.yaml
# 5. After applying, delete this file to avoid committing secrets
